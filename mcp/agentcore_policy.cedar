// AgentCore Policy (Cedar) for the EU engineering-knowledge gateway.
// Syntax follows the AWS "Example policies" pages (AgentCore::OAuthUser / IamEntity principals,
// AgentCore::Action::"<Target>___<tool>", AgentCore::Gateway::"<arn>", context.input = tool args).
// NOT validated: no Cedar CLI/cedarpy available offline and the entity schema is generated by
// AgentCore from the gateway's targets. Validate with the AgentCore policy engine before use.
// Semantics: default deny; any matching forbid overrides every permit.

// Scope matching. The OAuth `scope` claim reaches Cedar as ONE space-delimited string
// (RFC 6749 s3.3), e.g. "spec:read procedures:read". Cedar has no string split, so true
// set membership is not expressible on it. A bare substring test (`like "*spec:read*"`)
// is unsafe: it also matches "spec:read:admin" or "xspec:read". Instead each scope is
// matched as a whole space-delimited TOKEN: the whole claim, or the token at the start,
// end or middle. This assumes single-space delimiters (as RFC 6749 specifies) and scope
// names without `*`. If the IdP can emit one claim/tag per scope, or a Set-valued claim,
// prefer an exact `==` / `.contains()` check on that instead.

// 1. Engineers with spec:read may look up spec values, only for well-formed part ids.
permit(
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"EngKnowledge___get_spec_value",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-central-1:111122223333:gateway/eng-knowledge-gw-a1b2c3"
)
when {
  principal.hasTag("scope") &&
  (principal.getTag("scope") == "spec:read" ||
    principal.getTag("scope") like "spec:read *" ||
    principal.getTag("scope") like "* spec:read" ||
    principal.getTag("scope") like "* spec:read *") &&
  context.input.part_id like "*-*"
};

// 2. Procedure / incident search per scope.
permit(
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"EngKnowledge___search_procedures",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-central-1:111122223333:gateway/eng-knowledge-gw-a1b2c3"
)
when {
  principal.hasTag("scope") &&
  (principal.getTag("scope") == "procedures:read" ||
    principal.getTag("scope") like "procedures:read *" ||
    principal.getTag("scope") like "* procedures:read" ||
    principal.getTag("scope") like "* procedures:read *")
};

permit(
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"EngKnowledge___search_incidents",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-central-1:111122223333:gateway/eng-knowledge-gw-a1b2c3"
)
when {
  principal.hasTag("scope") &&
  (principal.getTag("scope") == "incidents:read" ||
    principal.getTag("scope") like "incidents:read *" ||
    principal.getTag("scope") like "* incidents:read" ||
    principal.getTag("scope") like "* incidents:read *")
};

// 3. Contractors (role claim) never see incident reports, whatever their scopes.
forbid(
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"EngKnowledge___search_incidents",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-central-1:111122223333:gateway/eng-knowledge-gw-a1b2c3"
)
when { principal.hasTag("role") && principal.getTag("role") == "contractor" };

// 4. Kill switch for one tool (e.g. while a tool-definition change is under review).
// forbid(principal, action == AgentCore::Action::"EngKnowledge___get_spec_value",
//        resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-central-1:111122223333:gateway/eng-knowledge-gw-a1b2c3");

// Prefer permit-lists of read actions (fail closed) over forbid-lists of write actions (fail open for new tools).
