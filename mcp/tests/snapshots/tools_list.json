[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Look up ONE controlled specification value for a part. Returns the exact value, unit, source document, page and revision. Always cite source_doc, page and revision.",
    "inputSchema": {
      "properties": {
        "parameter": {
          "description": "Spec parameter, e.g. max_bow",
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Parameter",
          "type": "string"
        },
        "part_id": {
          "description": "Part id, e.g. WFR-3001",
          "pattern": "^[A-Z]{2,5}-\\d{3,6}$",
          "title": "Part Id",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "parameter"
      ],
      "title": "get_spec_valueArguments",
      "type": "object"
    },
    "name": "get_spec_value",
    "outputSchema": {
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "source_doc": {
          "title": "Source Doc",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "description": "Exact value as written in the controlled spec (decimal string, lossless).",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "parameter",
        "value",
        "unit",
        "source_doc",
        "page",
        "revision"
      ],
      "title": "SpecValue",
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
